# Copy to .env for localhost. Supabase replaces DATABASE_URL later (see SETUP.md).
PORT=3000
DATABASE_URL=postgres://foodlog:foodlog@localhost:5432/foodlog

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# Google OAuth (optional until you create OAuth credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/v1/auth/google/callback

# Feature flags
FEATURE_SHOW_CONSUMED_DEFAULT=false
